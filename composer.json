{
    "name": "like/like-json",
    "description": "WordPress plugin for displaying student works (Abschlussarbeiten) from the LIKE database as a Gutenberg block and legacy shortcode.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "LIKE",
            "homepage": "https://www.like.tf.fau.de/"
        }
    ],
    "require": {
        "php": ">=8.0",
        "composer/installers": "^2.2"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpunit/phpunit": "^9.6"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint:php": "php -l like-json.php && find includes src templates -name '*.php' -print0 | xargs -0 -n1 php -l",
        "phpcs": "phpcs",
        "phpcs:fix": "phpcbf",
        "test": "php tests/run-tests.php"
    }
}
