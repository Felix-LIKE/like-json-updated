{
  "name": "like-json",
  "version": "2.1.0",
  "description": "WordPress plugin for displaying student works (Abschlussarbeiten) from the LIKE database as a Gutenberg block and legacy shortcode.",
  "author": "LIKE - Lehrstuhl für Informationstechnik mit dem Schwerpunkt Kommunikationselektronik",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Felix-LIKE/like-json-updated.git",
    "issues": "https://github.com/Felix-LIKE/like-json-updated/issues",
    "clone": "https://github.com/Felix-LIKE/like-json-updated.git"
  },
  "homepage": "https://github.com/Felix-LIKE/like-json-updated",
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "wp": {
    "requires": "6.0",
    "tested": "7.1",
    "php": "8.0"
  },
  "main": "like-json.php",
  "scripts": {
    "build": "wp-scripts build --webpack-src-dir=src --output-path=build",
    "start": "wp-scripts start --webpack-src-dir=src --output-path=build",
    "lint:js": "wp-scripts lint-js src",
    "lint:css": "wp-scripts lint-style 'src/**/*.scss'",
    "check": "wp-scripts check-licenses",
    "sync:version": "node bin/sync-version.js",
    "prebuild": "npm run sync:version"
  },
  "devDependencies": {
    "@wordpress/block-editor": "^19.0.0",
    "@wordpress/blocks": "^17.0.0",
    "@wordpress/components": "^43.0.0",
    "@wordpress/i18n": "^7.0.0",
    "@wordpress/scripts": "^37.0.0",
    "@wordpress/server-side-render": "^7.0.0"
  }
}
